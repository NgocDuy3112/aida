@inherits LayoutComponentBase

<ErrorBoundary @ref="errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent>
        <div class="blazor-error-boundary">
            Đã có lỗi khi hiển thị trang này.
            <button type="button" @onclick="Recover">Thử lại</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong đợi.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }

    private void Recover() => errorBoundary?.Recover();
}
