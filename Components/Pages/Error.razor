@page "/Error"
@using System.Diagnostics

<PageTitle>Lỗi</PageTitle>

<h1 class="text-danger">Lỗi.</h1>
<h2 class="text-danger">Đã có lỗi khi xử lý yêu cầu của bạn.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@RequestId</code>
    </p>
}

<h3>Chế độ Development</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> để xem thông tin chi tiết hơn về lỗi vừa xảy ra.
</p>
<p>
    <strong>Không bật môi trường Development cho ứng dụng đã deploy.</strong>
    Nó có thể làm lộ thông tin nhạy cảm từ exception cho người dùng cuối.
    Khi cần debug local, bật môi trường <strong>Development</strong> bằng cách set biến môi trường
    <strong>ASPNETCORE_ENVIRONMENT</strong> giá trị <strong>Development</strong> rồi khởi động lại app.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
