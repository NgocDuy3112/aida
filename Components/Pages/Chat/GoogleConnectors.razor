@using Microsoft.AspNetCore.Identity
@using aida.Extensions
@inject AuthenticationStateProvider AuthState
@inject UserManager<AppUser> UserManager
@inject IConfiguration Config

<div class="connectors">
    <button type="button" class="connectors-trigger @TriggerClass"
            title="Google connectors"
            aria-label="Google connectors"
            aria-haspopup="dialog"
            aria-expanded="@ExpandedValue"
            @onclick="Toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 22v-5M9 8V2M15 8V2M18 8v3a6 6 0 0 1-12 0V8Z" />
        </svg>
        @if (!connected)
        {
            <span class="connectors-badge" aria-hidden="true"></span>
        }
    </button>

    @if (open)
    {
        <div class="connectors-backdrop" @onclick="Close"></div>
        <div class="connectors-menu" role="dialog" aria-label="Google connectors">
            <p class="connectors-heading">Google connectors</p>

            @if (!googleConfigured)
            {
                <p class="connectors-note">
                    Google sign-in isn't configured. Set
                    <code>Authentication__Google__ClientId</code> and
                    <code>Authentication__Google__ClientSecret</code> in <code>.env</code>
                    to enable it.
                </p>
            }

            @foreach (var tool in Connectors)
            {
                <div class="connector-row">
                    <span class="connector-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="@tool.IconPath" />
                        </svg>
                    </span>
                    <span class="connector-name">@tool.Name</span>

                    @if (connected)
                    {
                        <form method="post" action="/account/google/disconnect" class="toggle-form">
                            <AntiforgeryToken />
                            <button type="submit" class="connector-toggle is-on"
                                    role="switch" aria-checked="true"
                                    aria-label="@tool.Name" title="Turn off @tool.Name">
                            </button>
                        </form>
                    }
                    else if (googleConfigured)
                    {
                        <form method="get" action="/account/external-login" class="toggle-form">
                            <input type="hidden" name="provider" value="Google" />
                            <input type="hidden" name="returnUrl" value="/" />
                            <button type="submit" class="connector-toggle"
                                    role="switch" aria-checked="false"
                                    aria-label="@tool.Name" title="Turn on @tool.Name">
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="connector-toggle connector-toggle-standalone"
                                role="switch" aria-checked="false"
                                aria-label="@tool.Name" title="@tool.Name" disabled>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private sealed record Connector(string Name, string IconPath);

    private static readonly Connector[] Connectors =
    [
        new("Google Drive",
            "M12.01 1.485c-2.082 0-3.754.02-3.743.047.01.02 1.708 3.001 3.774 6.62l3.76 6.574h3.76c2.081 0 3.753-.02 3.742-.047-.005-.02-1.708-3.001-3.775-6.62l-3.76-6.574zm-4.76 1.73a789.828 789.861 0 0 0-3.63 6.319L0 15.868l1.89 3.298 1.885 3.297 3.62-6.335 3.618-6.33-1.88-3.287C8.1 4.704 7.255 3.22 7.25 3.214zm2.259 12.653-.203.348c-.114.198-.96 1.672-1.88 3.287a423.93 423.948 0 0 1-1.698 2.97c-.01.026 3.24.042 7.222.042h7.244l1.796-3.157c.992-1.734 1.85-3.23 1.906-3.323l.104-.167h-7.249z"),
        new("Google Docs",
            "M14.727 6.727H14V0H4.91c-.905 0-1.637.732-1.637 1.636v20.728c0 .904.732 1.636 1.636 1.636h14.182c.904 0 1.636-.732 1.636-1.636V6.727h-6zm-.545 10.455H7.09v-1.364h7.09v1.364zm2.727-3.273H7.091v-1.364h9.818v1.364zm0-3.273H7.091V9.273h9.818v1.363zM14.727 6h6l-6-6v6z"),
        new("Google Sheets",
            "M11.318 12.545H7.91v-1.909h3.41v1.91zM14.728 0v6h6l-6-6zm1.363 10.636h-3.41v1.91h3.41v-1.91zm0 3.273h-3.41v1.91h3.41v-1.91zM20.727 6.5v15.864c0 .904-.732 1.636-1.636 1.636H4.909a1.636 1.636 0 0 1-1.636-1.636V1.636C3.273.732 4.005 0 4.909 0h9.318v6.5h6.5zm-3.273 2.773H6.545v7.909h10.91v-7.91zm-6.136 4.636H7.91v1.91h3.41v-1.91z"),
    ];

    private bool open;
    private bool connected;
    private bool googleConfigured;

    private string? TriggerClass
    {
        get
        {
            if (open)
            {
                return "is-open";
            }
            return null;
        }
    }

    private string ExpandedValue
    {
        get
        {
            if (open)
            {
                return "true";
            }
            return "false";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        googleConfigured = IdentityExtensions.IsGoogleConfigured(Config);

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            connected = false;
            return;
        }

        connected = !string.IsNullOrWhiteSpace(user.GoogleRefreshToken);
    }

    private void Toggle()
    {
        open = !open;
    }

    private void Close()
    {
        open = false;
    }
}
