@using System.Runtime.CompilerServices
@using System.Text.RegularExpressions
@using System.Linq
@inject IJSRuntime JS

@if (Message.Role == ChatRole.User)
{
    <div class="user-message">
        @if (editing)
        {
            <span class="message-sizer" aria-hidden="true">@Message.Text</span>
            <div class="message-edit-overlay">
                <textarea class="message-edit-input" @bind="draft"></textarea>
                <div class="message-edit-actions">
                    <button type="button" class="message-edit-save" @onclick="SaveEditAsync">Lưu</button>
                    <button type="button" class="message-edit-cancel" @onclick="CancelEdit">Huỷ</button>
                </div>
            </div>
        }
        else
        {
        @if (AttachedFileNames is not null)
        {
            <div class="message-file-chips">
                @foreach (var name in AttachedFileNames)
                {
                    <span class="message-file-chip">
                        <svg class="message-file-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M14 3v5h5M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
                        </svg>
                        <span class="message-file-chip-name">@name</span>
                    </span>
                }
            </div>
        }
        @if (imageSources.Count > 0)
        {
            <div class="message-images">
                @foreach (var src in imageSources)
                {
                    <img src="@src" alt="Attached image" loading="lazy" />
                }
            </div>
        }
        <chat-markdown markdown="@Message.Text" />
        @if (Editable)
        {
            <button type="button" class="message-edit-btn" aria-label="Sửa tin nhắn"
                    title="Sửa tin nhắn" @onclick="StartEdit">✎</button>
        }
        }
    </div>
}
else if (Message.Role == ChatRole.Assistant)
{
    <div class="assistant-turn">
    @foreach (var content in Message.Contents)
    {
        if (content is TextContent { Text: { Length: > 0 } text })
        {
            <div class="assistant-message">
                <div>
                    <div class="assistant-message-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                        </svg>
                    </div>
                </div>
                <div class="assistant-message-header">Trợ lý</div>
                <div class="assistant-message-text" aria-live="@(InProgress ? "polite" : null)" aria-busy="@(InProgress ? "true" : null)">
                    <assistant-message markdown="@text"></assistant-message>

                    @foreach (var citation in citations ?? [])
                    {
                        <ChatCitation File="@citation.File" Quote="@citation.Quote" />
                    }
                </div>
            </div>
        }
        else if (content is FunctionCallContent { Name: "LoadDocuments" })
        {
            <div class="assistant-search">
                <div class="assistant-search-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                </div>
                <div class="assistant-search-content">
                    Loading relevant documents (this will take a minute)...
                </div>
            </div>
        }
        else if (content is FunctionCallContent { Name: "Search" } fcc && fcc.Arguments?.TryGetValue("searchPhrase", out var searchPhrase) is true)
        {
            <div class="assistant-search">
                <div class="assistant-search-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </div>
                <div class="assistant-search-content">
                    Searching:
                    <span class="assistant-search-phrase">@searchPhrase</span>
                    @if (fcc.Arguments?.TryGetValue("filenameFilter", out var filenameObj) is true && filenameObj is string filename && !string.IsNullOrEmpty(filename))
                    {
                        <text> in </text><span class="assistant-search-phrase">@filename</span>
                    }
                </div>
            </div>
        }
    }

    @if (HasAssistantText && (Trace is not null || CanRegenerate))
    {
        <div class="assistant-message-actions">
            @if (Trace is { } trace)
            {
                <button type="button" class="process-trace-chip"
                        aria-expanded="@(traceOpen ? "true" : "false")"
                        @onclick="() => traceOpen = !traceOpen">
                    <svg class="process-trace-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M10.34 15.84a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 0 0-7.07-7.07l-1.42 1.41" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M13.66 8.16a5 5 0 0 0-7.07 0l-2.12 2.12a5 5 0 0 0 7.07 7.07l1.41-1.41" />
                    </svg>
                    <span>Đã dùng @trace.ToolCalls công cụ</span>
                </button>
                @if (traceOpen)
                {
                    <ul class="process-trace-steps">
                        @foreach (var step in trace.Steps)
                        {
                            <li>@step</li>
                        }
                    </ul>
                }
            }
            @if (CanRegenerate)
            {
                <button type="button" class="message-regenerate-btn" title="Tạo lại câu trả lời"
                        aria-label="Tạo lại câu trả lời" @onclick="() => OnRegenerate.InvokeAsync()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M4 12a8 8 0 0 1 13.66-5.66L20 8m0-4v4h-4M20 12a8 8 0 0 1-13.66 5.66L4 16m0 4v-4h4" />
                    </svg>
                    <span>Tạo lại</span>
                </button>
            }
        </div>
    }
    </div>
}

@code {
    private static readonly ConditionalWeakTable<ChatMessage, ChatMessageItem> SubscribersLookup = new();
    private static readonly Regex CitationRegex = new(@"<citation filename='(?<file>[^']*)'>(?<quote>.*?)</citation>", RegexOptions.NonBacktracking);

    private List<(string File, string Quote)>? citations;
    private List<string> imageSources = [];

    [Parameter, EditorRequired]
    public required ChatMessage Message { get; set; }

    [Parameter]
    public IReadOnlyDictionary<ChatMessage, List<string>>? Attachments { get; set; }

    private List<string>? AttachedFileNames
    {
        get
        {
            if (Attachments is null)
                return null;
            if (Attachments.TryGetValue(Message, out var files))
                return files;
            return null;
        }
    }

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public EventCallback<(ChatMessage Message, string Text)> OnEdit { get; set; }

    private bool editing;
    private string draft = string.Empty;

    private void StartEdit()
    {
        draft = Message.Text ?? string.Empty;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
    }

    private async Task SaveEditAsync()
    {
        if (string.Equals(draft.Trim(), (Message.Text ?? string.Empty).Trim(), StringComparison.Ordinal))
        {
            editing = false;
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Sửa tin nhắn sẽ xoá toàn bộ câu trả lời phía sau. Tiếp tục?");
        if (!confirmed)
            return;

        editing = false;
        await OnEdit.InvokeAsync((Message, draft));
    }

    [Parameter]
    public bool InProgress { get; set;}

    [Parameter]
    public ProcessTrace? Trace { get; set; }

    [Parameter]
    public bool CanRegenerate { get; set; }

    [Parameter]
    public EventCallback OnRegenerate { get; set; }

    private bool traceOpen;

    private bool HasAssistantText => !string.IsNullOrWhiteSpace(Message.Text);

    [Parameter]
    public int StreamVersion { get; set; }

    protected override void OnInitialized()
    {
        SubscribersLookup.AddOrUpdate(Message, this);

        imageSources = Message.Contents
            .OfType<DataContent>()
            .Where(c => c.MediaType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true)
            .Select(c => c.Uri ?? $"data:{c.MediaType};base64,{Convert.ToBase64String(c.Data.Span)}")
            .ToList();

        if (!InProgress && Message.Role == ChatRole.Assistant && Message.Text is { Length: > 0 } text)
        {
            ParseCitations(text);
        }
    }

    public static void NotifyChanged(ChatMessage source)
    {
        if (SubscribersLookup.TryGetValue(source, out var subscriber))
        {
            subscriber.StateHasChanged();
        }
    }

    private void ParseCitations(string text)
    {
        var matches = CitationRegex.Matches(text);
        citations = matches.Any()
            ? matches.Select(m => (m.Groups["file"].Value, m.Groups["quote"].Value)).ToList()
            : null;
    }
}
