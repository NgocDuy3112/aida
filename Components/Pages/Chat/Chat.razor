@page "/"
@attribute [Authorize]
@using System.Security.Claims
@using System.Diagnostics
@using System.Text.RegularExpressions
@using aida.Services.Ingestion
@using Microsoft.AspNetCore.Identity
@using OpenAI
@using Microsoft.Agents.AI
@implements IDisposable
@inject SemanticSearch Search
@inject OpenAIClient OpenAi
@inject SystemOneRouter Router
@inject IConfiguration Config
@inject IConversationStore Store
@inject AuthenticationStateProvider AuthState
@inject DocumentService Documents
@inject IWebHostEnvironment Env
@inject ILogger<Chat> Logger
@inject GoogleWorkspaceService GoogleWorkspace
@inject UserManager<AppUser> UserManager
@inject IChatRateLimiter RateLimiter
@inject IUsageTracker UsageTracker
@inject PricingTable Pricing
@inject ParallelResearchTool ResearchTools
@inject CrewWriterTool CrewWriter
@inject WebSearchTool WebSearch
@inject OcrOptions Ocr

<PageTitle>Chat</PageTitle>

<div class="app-shell">
    <ChatSidebar
    @ref="sidebar"
    ActiveId="conversationId"
    Open="@sidebarOpen"
    OnSelect="SelectConversationAsync"
    OnNewChat="ResetConversationAsync"
    />
    @if (sidebarOpen)
    {
        <div class="sidebar-backdrop" aria-hidden="true" @onclick="() => sidebarOpen = false"></div>
    }

    <main class="chat-main">
        <ChatHeader
        Title="@title"
        SidebarOpen="@sidebarOpen"
        OnToggleSidebar="() => sidebarOpen = !sidebarOpen"
        />

        <ChatMessageList Messages="@messages" Attachments="@messageAttachments" Editable="@CanEditMessages" OnEditMessage="@EditUserMessageAsync" InProgressMessage="@currentResponseMessage" StreamVersion="@streamVersion" ProcessSteps="@processSteps">
            <NoMessagesContent>
                <div class="empty-state">
                    <h2>AIDA Agent</h2>
                </div>
            </NoMessagesContent>
        </ChatMessageList>

        <div class="chat-container">
            @if (status is not null)
            {
                <p class="status">@status</p>
            }
            @if (pendingOptions.Count >= 2)
            {
                <div class="ask-user-panel" role="group" aria-label="Lựa chọn nhanh">
                    @foreach (var option in pendingOptions)
                    {
                        <button type="button" class="ask-user-option" @onclick="() => AnswerQuizAsync(option)">@option</button>
                    }
                </div>
            }
            <ChatInput
            OnSend="@AddUserMessageAsync"
            OnFileSelected="@UploadAsync"
            AttachedFiles="@attachedFiles"
            OnRemoveFile="@RemoveAttachedFile"
            @bind-PinnedModel="pinnedModel"
            StatusChanged="@((string? s) => status = s)"
            IsStreaming="@(currentResponseMessage is not null)"
            OnStop="@CancelAnyCurrentResponse"
            @ref="@chatInput"
            />
        </div>
    </main>
</div>

@code {
    private readonly List<ChatMessage> messages = new();
    private readonly Dictionary<ChatMessage, List<string>> messageAttachments = [];
    private CancellationTokenSource? currentResponseCancellation;
    private ChatMessage? currentResponseMessage;
    private ChatInput? chatInput;
    private ChatSidebar? sidebar;
    private List<string> pendingOptions = [];

    private string userId = string.Empty;
    private Guid? conversationId;
    private string? title;
    private readonly List<string> attachedFiles = [];
    private string? status;
    private string? pendingQuestion;

    private bool CanEditMessages
    {
        get
        {
            if (currentResponseMessage is not null)
                return false;
            return true;
        }
    }
    private string systemPrompt = string.Empty;
    private string? pinnedModel;
    private int streamVersion;
    private bool sidebarOpen;
    private CrewState crew = null!;

    private readonly List<string> processSteps = [];

    private static string? ReadString(IDictionary<string, object?> a, string key) =>
    a.TryGetValue(key, out var v)
        ? v switch
        {
            string s => s,
            System.Text.Json.JsonElement { ValueKind: System.Text.Json.JsonValueKind.String } e => e.GetString(),
            _ => null
        }
        : null;

    private static List<string> ReadStrings(IDictionary<string, object?> a, string key)
    {
        if (!a.TryGetValue(key, out var v)) return [];
        return v switch
        {
            System.Text.Json.JsonElement { ValueKind: System.Text.Json.JsonValueKind.Array } e =>
                e.EnumerateArray().Select(x => x.GetString()).OfType<string>().ToList(),
            IEnumerable<object?> list => list.Select(x => x?.ToString()).OfType<string>().ToList(),
            _ => []
        };
    }

    private Task AnswerQuizAsync(string option)
    {
        pendingOptions = [];
        pendingQuestion = null;
        pendingOptions = [];
        return AddUserMessageAsync(new ChatMessage(ChatRole.User, option));
    }

    private void AddStep(string step)
    {
        if (processSteps.Count == 0 || processSteps[^1] != step)
            processSteps.Add(step);
    }

    protected override async Task OnInitializedAsync()
    {
        systemPrompt = File.ReadAllText(
            Path.Combine(Env.ContentRootPath, "prompts", "SYSTEM.md"));

        var state = await AuthState.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var appUser = await UserManager.FindByIdAsync(userId);
        crew = AgentSettings.Load(appUser, Config);
        messages.Add(new(ChatRole.System, systemPrompt));
    }

    private Task AddUserMessageAsync(ChatMessage userMessage)
        => ProcessUserMessageAsync(userMessage, true);

    private async Task EditUserMessageAsync((ChatMessage Message, string Text) edit)
    {
        var original = edit.Message;
        var newText = edit.Text;

        if (conversationId is null || string.IsNullOrWhiteSpace(userId)) return;
        if (currentResponseMessage is not null) return;

        var index = messages.IndexOf(original);
        if (index < 1) return;

        var trimmed = newText.Trim();
        if (trimmed.Length == 0) return;
        if (string.Equals(trimmed, original.Text, StringComparison.Ordinal)) return;

        for (var i = messages.Count - 1; i > index; i--)
        {
            messageAttachments.Remove(messages[i]);
            messages.RemoveAt(i);
        }
        await Store.DeleteMessagesFromAsync(conversationId.Value, userId, index + 1);

        var text = original.Contents.OfType<TextContent>().FirstOrDefault();
        if (text is null) return;
        text.Text = trimmed;
        await Store.UpdateMessageAsync(conversationId.Value, userId, index, trimmed);

        agentRuns.Remove(conversationId.Value);
        ChatMessageItem.NotifyChanged(original);
        streamVersion++;
        await InvokeAsync(StateHasChanged);

        await ProcessUserMessageAsync(original, false);
    }

    private async Task<bool> TrySteerAsync(ChatMessage userMessage)
    {
        if (currentResponseMessage is null) return false;
        if (conversationId is null) return false;
        if (!agentRuns.TryGetValue(conversationId.Value, out var activeRun)) return false;

        var question = userMessage.Text ?? string.Empty;
        messages.Add(userMessage);
        if (attachedFiles.Count > 0)
            messageAttachments[userMessage] = new List<string>(attachedFiles);
        await Store.AppendAsync(conversationId.Value, userId, "user", question);

        await activeRun.Injector.EnqueueMessagesAsync(
            activeRun.Session, [userMessage], CancellationToken.None);
        status = "Đã chuyển yêu cầu vào câu trả lời đang chạy…";
        return true;
    }

    private async Task ProcessUserMessageAsync(ChatMessage userMessage, bool append)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;

        if (!await RateLimiter.TryAcquireAsync(userId))
        {
            status = "Bạn gửi tin quá nhanh — đợi một lát rồi thử lại.";
            return;
        }

        ChatMessage? myResponse = null;
        TextContent? responseText = null;
        var usedModel = "unknown";
        var toolCalls = 0;
        var llmClock = Stopwatch.StartNew();
        try
        {
            await EnsureConversationAsync();

            if (await TrySteerAsync(userMessage)) return;

            CancelAnyCurrentResponse();

            var question = userMessage.Text ?? string.Empty;
            if (append)
            {
                messages.Add(userMessage);
                if (attachedFiles.Count > 0)
                    messageAttachments[userMessage] = new List<string>(attachedFiles);
                await Store.AppendAsync(conversationId!.Value, userId, "user", question);
            }

            status = null;
            processSteps.Clear();
            pendingQuestion = null;
            pendingOptions = [];
            AddStep("Đang suy nghĩ…");
            await chatInput!.FocusAsync();


            var modelTask = pinnedModel is not null
                ? Task.FromResult(pinnedModel)
                : Router.PickChatModelAsync(question);
            var hitsTask = Task.FromResult<IReadOnlyList<IngestedChunk>>([]);
            var searchScope = BuildSearchScope(question);
            if (searchScope.Count > 0)
                hitsTask = Search.SearchAsync(question, userId, searchScope, maxResults: 6);

            await Task.WhenAll(modelTask, hitsTask);

            var model = await modelTask;
            usedModel = model;
            var modelSource = "router";
            if (pinnedModel is not null)
                modelSource = "pinned";
            Logger.LogInformation(
                "Answering with {Model} ({Source})",
                model,
                modelSource);
            var hits = await hitsTask;
            if (hits.Count > 0)
                AddStep($"Đã tìm {hits.Count} đoạn");
            var prompt = BuildPrompt(question, hits, attachedFiles);

            responseText = new TextContent("");
            myResponse = new ChatMessage(ChatRole.Assistant, [responseText]);
            currentResponseMessage = myResponse;
            currentResponseCancellation = new();
            await InvokeAsync(StateHasChanged);

            var (harness, session, sessionFresh) = await GetAgentRunAsync(conversationId!.Value, model);

            var currentContents = new List<AIContent> { new TextContent(prompt) };
            currentContents.AddRange(messages[^1].Contents.OfType<DataContent>());
            var currentMessage = new ChatMessage(ChatRole.User, currentContents);
            var agentInput = BuildAgentInput(sessionFresh, currentMessage);

            await foreach (var update in harness.RunStreamingAsync(
                agentInput, session, cancellationToken: currentResponseCancellation.Token))
            {
                await ProcessUpdateAsync(update.Text, update.Contents);
            }

            llmClock.Stop();
            if (!string.IsNullOrWhiteSpace(pendingQuestion))
            {
                responseText.Text = pendingQuestion;
                ChatMessageItem.NotifyChanged(myResponse);
                agentRuns.Remove(conversationId!.Value);
            }
            messages.Add(myResponse);
            currentResponseMessage = null;

            if (!string.IsNullOrWhiteSpace(responseText.Text))
            {
                await Store.AppendAsync(conversationId!.Value, userId, "assistant", responseText.Text);
                AttachGeneratedDocuments(responseText.Text);
                await MaybeGenerateTitleAsync(question, responseText.Text);
            }

            await sidebar!.ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            if (myResponse is not null && ReferenceEquals(currentResponseMessage, myResponse))
            {
                messages.Add(myResponse);
                currentResponseMessage = null;
            }

            llmClock.Stop();
            _ = UsageTracker.RecordAsync(new UsageEvent
            {
                UserId = userId,
                Model = usedModel,
                Mode = "agent",
                DurationMs = llmClock.ElapsedMilliseconds,
                ToolCalls = toolCalls,
                Error = "cancelled",
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to answer message.");
            status = "Đã có lỗi khi trả lời. Vui lòng thử lại.";
            if (myResponse is not null && ReferenceEquals(currentResponseMessage, myResponse))
            {
                messages.Add(myResponse);
                currentResponseMessage = null;
            }

            llmClock.Stop();
            _ = UsageTracker.RecordAsync(new UsageEvent
            {
                UserId = userId,
                Model = usedModel,
                Mode = "agent",
                DurationMs = llmClock.ElapsedMilliseconds,
                ToolCalls = toolCalls,
                Error = ex.Message,
            });
        }

        async Task ProcessUpdateAsync(string? text, IList<AIContent> contents)
        {
            foreach (var item in contents)
            {
                if (item is FunctionCallContent call)
                {
                    toolCalls++;
                    Logger.LogDebug("FunctionCall: {Name} args={Args}",
                        call.Name, System.Text.Json.JsonSerializer.Serialize(call.Arguments));
                    if (call.Name == AskUserTool.Name && call.Arguments is { } args)
                    {
                        pendingQuestion = ReadString(args, "question") ?? pendingQuestion;
                        pendingOptions = ReadStrings(args, "options");
                        await chatInput!.FocusAsync();
                    }
                    else
                    {
                        AddStep($"Dùng {call.Name.Replace('_', ' ')}");
                    }
                    streamVersion++;
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (string.IsNullOrEmpty(text)) return;

            responseText!.Text += text;
            AddStep("Đang tạo");
            streamVersion++;
            ChatMessageItem.NotifyChanged(myResponse!);
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<string> BuildSearchScope(string question)
    {
        var scope = new List<string>(attachedFiles);
        var documentsDir = Path.Combine(Env.ContentRootPath, "App_Data", "documents", userId);
        if (Directory.Exists(documentsDir))
        {
            foreach (var path in Directory.EnumerateFiles(documentsDir))
            {
                var name = Path.GetFileName(path);
                if (scope.Contains(name))
                    continue;
                if (question.Contains(name, StringComparison.OrdinalIgnoreCase))
                    scope.Add(name);
            }
        }
        return scope;
    }

    private static string BuildPrompt(
        string question, IReadOnlyList<IngestedChunk> hits, IReadOnlyList<string> attachedFiles)
    {
        var parts = new List<string>();

        if (attachedFiles.Count > 0)
        {
            parts.Add("<attached-files>\n" + string.Join("\n", attachedFiles) + "\n</attached-files>");
        }

        if (hits.Count > 0)
        {
            var context = string.Join("\n", hits.Select(h =>
                $"<result filename=\"{h.DocumentId}\">{h.Text}</result>"));
            parts.Add("<context>\n" + context + "\n</context>");
        }

        parts.Add($"Question: {question}");
        return string.Join("\n\n", parts);
    }

    private readonly Dictionary<string, IChatClient> chatClients = [];

    private sealed record AgentRun(HarnessAgent Agent, AgentSession Session, string Model, CrewState Crew, MessageInjectingChatClient Injector);

    private readonly Dictionary<Guid, AgentRun> agentRuns = [];

    private IChatClient CreateChatClient(string model)
    {
        if (!chatClients.TryGetValue(model, out var client))
        {
            client = OpenAi.GetChatClient(model).AsIChatClient();
            chatClients[model] = client;
        }
        return client;
    }

    private async Task<(HarnessAgent Agent, AgentSession Session, bool Fresh)> GetAgentRunAsync(
        Guid conversationId, string model)
    {
        if (agentRuns.TryGetValue(conversationId, out var existing)
            && existing.Model == model && existing.Crew == crew)
            return (existing.Agent, existing.Session, false);

        var reporting = new UsageReportingChatClient(
            OpenAi.GetChatClient(model).AsIChatClient(),
            UsageTracker, Pricing, userId, model, "agent");

        var tools = BuildAgentTools(model);
        Logger.LogInformation("Agent tools: {Tools}",
            string.Join(", ", tools.OfType<AIFunctionDeclaration>().Select(t => t.Name)));

        var harnessInstructions = systemPrompt + "\n" + AskUserTool.Instructions;
        Logger.LogDebug("Instructions tail: {Tail}", harnessInstructions[^220..]);

        var injecting = new MessageInjectingChatClient(reporting);
        var agent = injecting
            .AsHarnessAgent(new HarnessAgentOptions
            {
                Name = "Agent nghiên cứu tài liệu",
                HarnessInstructions = harnessInstructions,
                MaximumIterationsPerRequest = 12,
                DisableWebSearch = true,
                DisableFileMemory = true,
                DisableAgentModeProvider = true,
                ChatOptions = new ChatOptions
                {
                    Tools = tools,
                    Reasoning = CrewOptions.Reasoning(crew.DirectorThinking),
                },
            });

        var session = await agent.CreateSessionAsync();
        agentRuns[conversationId] = new AgentRun(agent, session, model, crew, injecting);
        return (agent, session, true);
    }

    private List<ChatMessage> BuildAgentInput(bool sessionFresh, ChatMessage currentMessage)
    {
        if (!sessionFresh)
        {
            return [currentMessage];
        }

        var history = messages
            .Take(messages.Count - 1)
            .Where(m => m.Role != ChatRole.System)
            .Where(m => !string.IsNullOrWhiteSpace(m.Text))
            .TakeLast(8)
            .Select(m => new ChatMessage(m.Role, TruncateForHistory(m.Text)))
            .ToList();

        history.Add(currentMessage);
        return history;
    }

    private static string TruncateForHistory(string text)
    {
        if (text.Length <= 1500)
        {
            return text;
        }
        return text[..1500] + " …";
    }

    private List<AITool> BuildAgentTools(string model)
    {
        List<AITool> tools =
        [
            ChatDocumentTools.CreateReadDocument(userId, Env, Ocr),
            ChatDocumentTools.CreateSaveDocument(userId, Documents, GoogleWorkspace, UserManager),
            ResearchTools.Create(userId, crew.ResearcherModel, crew.ResearcherThinking),
            CrewWriter.Create(userId, crew.WriterModel, crew.WriterThinking),
            AskUserTool.Create(),
        ];

        var search = WebSearch.Create();
        if (search is not null) tools.Add(search);

        return tools;
    }

    private async Task UploadAsync(IBrowserFile file)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;

        if (!attachedFiles.Contains(file.Name))
        {
            attachedFiles.Add(file.Name);
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            status = $"Đang đọc {file.Name}…";
            await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await Documents.SaveAndIngestAsync(stream, file.Name, userId);
            status = null;
        }
        catch (Exception ex)
        {
            attachedFiles.Remove(file.Name);
            status = $"Không đọc được file đó: {ex.Message}";
        }
    }

    private void RemoveAttachedFile(string name)
    {
        attachedFiles.Remove(name);
        status = null;
    }

    private void AttachGeneratedDocuments(string responseText)
    {
        foreach (Match match in Regex.Matches(responseText, "/documents/([^)\\]\\s\"']+)"))
        {
            var name = Uri.UnescapeDataString(match.Groups[1].Value);
            if (!attachedFiles.Contains(name))
                attachedFiles.Add(name);
        }
    }

    private async Task EnsureConversationAsync()
    {
        if (conversationId is not null) return;
        var created = await Store.CreateAsync(userId);
        conversationId = created.Id;
        title = created.Title;
    }

    private async Task MaybeGenerateTitleAsync(string question, string answer)
    {
        if (title is not null && title != "Chat mới") return;

        var fallback = question.Length > 60 ? question[..60] : question;
        var generated = fallback;

        try
        {
            var lightModel = Config["Models:LightModel"]!;
            var client = CreateChatClient(lightModel);
            var response = await client.GetResponseAsync(
                $"Give a 3-5 word title for a conversation that starts with: {question}");
            var candidate = response.Text?.Trim().Trim('"', '.', '\n');
            if (!string.IsNullOrWhiteSpace(candidate) && candidate.Length <= 60)
                generated = candidate;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Title generation failed — using fallback title '{Title}'.", generated);
        }

        title = generated;
        await Store.RenameAsync(conversationId!.Value, userId, generated);
    }

    private async Task SelectConversationAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(userId) || id == conversationId) return;

        CancelAnyCurrentResponse();

        var rows = await Store.LoadMessagesAsync(id, userId);
        var list = await Store.ListAsync(userId);
        var summary = list.FirstOrDefault(c => c.Id == id);

        messages.Clear();
        messages.Add(new(ChatRole.System, systemPrompt));
        foreach (var row in rows)
        {
            messages.Add(new ChatMessage(
                row.Role == "assistant" ? ChatRole.Assistant : ChatRole.User, row.Text));
        }

        conversationId = id;
        title = summary?.Title;
        status = null;
        pendingQuestion = null;
        pendingOptions = [];
        processSteps.Clear();
        sidebarOpen = false;
        await sidebar!.ReloadAsync();
        await chatInput!.FocusAsync();
    }

    private void CancelAnyCurrentResponse()
    {
        if (currentResponseMessage is not null) messages.Add(currentResponseMessage);
        currentResponseCancellation?.Cancel();
        currentResponseMessage = null;
    }

    private async Task ResetConversationAsync()
    {
        CancelAnyCurrentResponse();
        messages.Clear();
        messages.Add(new(ChatRole.System, systemPrompt));
        conversationId = null;
        pinnedModel = null;
        title = null;
        status = null;
        pendingQuestion = null;
        pendingOptions = [];
        processSteps.Clear();
        sidebarOpen = false;
        if (sidebar is not null) await sidebar.ReloadAsync();
        if (chatInput is not null) await chatInput.FocusAsync();
    }

    public void Dispose()
    {
        currentResponseCancellation?.Cancel();
    }
}
