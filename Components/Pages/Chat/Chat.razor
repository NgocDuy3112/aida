@page "/"
@attribute [Authorize]
@using System.Security.Claims
@using aida.Services.Ingestion
@using Microsoft.AspNetCore.Identity
@using OpenAI
@using Microsoft.Agents.AI
@implements IDisposable
@implements IChatTurnView
@inject SemanticSearch Search
@inject OpenAIClient OpenAi
@inject SystemOneRouter Router
@inject IConfiguration Config
@inject IConversationStore Store
@inject AuthenticationStateProvider AuthState
@inject DocumentService Documents
@inject IWebHostEnvironment Env
@inject ILogger<Chat> Logger
@inject UserManager<AppUser> UserManager
@inject IChatRateLimiter RateLimiter
@inject IUsageTracker UsageTracker
@inject PricingTable Pricing
@inject ParallelResearchTool ResearchTools
@inject CrewWriterTool CrewWriter
@inject WebSearchTool WebSearch
@inject OcrOptions Ocr

<PageTitle>Chat</PageTitle>

<div class="app-shell">
    <ChatSidebar
    @ref="sidebar"
    ActiveId="@chatRunner.ConversationId"
    Open="@sidebarOpen"
    OnSelect="SelectConversationAsync"
    OnNewChat="ResetConversationAsync"
    />
    @if (sidebarOpen)
    {
        <div class="sidebar-backdrop" aria-hidden="true" @onclick="() => sidebarOpen = false"></div>
    }

    <main class="chat-main">
        <ChatHeader
        Title="@chatRunner.Title"
        Model="@chatRunner.ActiveModel"
        SidebarOpen="@sidebarOpen"
        OnToggleSidebar="() => sidebarOpen = !sidebarOpen"
        />

        <ChatMessageList Messages="@chatRunner.Messages" Attachments="@chatRunner.MessageAttachments" Editable="@chatRunner.CanEditMessages" OnEditMessage="@EditUserMessageAsync" InProgressMessage="@chatRunner.CurrentResponseMessage" StreamVersion="@streamVersion" ProcessSteps="@chatRunner.ProcessSteps" Traces="@chatRunner.MessageTraces" LastAssistantMessage="@LastAssistantMessage" OnRegenerate="@RegenerateAsync">
            <NoMessagesContent>
                <div class="empty-state">
                    <h2>AIDA Agent</h2>
                    <div class="empty-prompts">
                        @foreach (var suggestion in EmptyStatePrompts)
                        {
                            var prompt = suggestion;
                            <button type="button" class="empty-prompt"
                                    @onclick="() => AddUserMessageAsync(new ChatMessage(ChatRole.User, prompt))">@prompt</button>
                        }
                    </div>
                </div>
            </NoMessagesContent>
        </ChatMessageList>

        <div class="chat-container">
            @if (chatRunner.Status is not null || (chatRunner.LastResponseFailed && chatRunner.CurrentResponseMessage is null))
            {
                <div class="status-row">
                    @if (chatRunner.Status is not null)
                    {
                        <p class="status">@chatRunner.Status</p>
                    }
                    @if (chatRunner.LastResponseFailed && chatRunner.CurrentResponseMessage is null)
                    {
                        <button type="button" class="status-retry" @onclick="RegenerateAsync">Thử lại</button>
                    }
                </div>
            }
            @if (pendingQuestion is not null || pendingOptions.Count > 0)
            {
                <div class="ask-user-panel" role="group" aria-label="Câu hỏi từ trợ lý">
                    <span class="ask-user-badge">Câu hỏi</span>
                    @if (pendingQuestion is not null)
                    {
                        <p class="ask-user-question">@pendingQuestion</p>
                    }
                    @if (pendingOptions.Count > 0)
                    {
                        <div class="ask-user-options">
                            @foreach (var option in pendingOptions)
                            {
                                <button type="button" class="ask-user-option" @onclick="() => AnswerQuestion(option)">@option</button>
                            }
                        </div>
                    }
                    <form class="ask-user-form" @onsubmit="SubmitPendingAnswerAsync" @onsubmit:preventDefault>
                        @if (pendingAllowFreeText)
                        {
                            <input class="ask-user-input" @ref="askUserInput" @bind="pendingAnswer"
                                   placeholder="Trả lời của bạn" aria-label="Trả lời câu hỏi của trợ lý" />
                            <button type="submit" class="ask-user-send"
                                    disabled="@(string.IsNullOrWhiteSpace(pendingAnswer))">Gửi</button>
                        }
                        <button type="button" class="ask-user-skip" @onclick="SkipQuestion">Bỏ qua</button>
                    </form>
                </div>
            }
            <ChatInput
            OnSend="@AddUserMessageAsync"
            OnFileSelected="@UploadAsync"
            AttachedFiles="@chatRunner.AttachedFiles"
            OnRemoveFile="@RemoveAttachedFile"
            @bind-PinnedModel="pinnedModel"
            StatusChanged="@((string? s) => chatRunner.Status = s)"
            IsStreaming="@(chatRunner.CurrentResponseMessage is not null)"
            OnStop="@CancelAnyCurrentResponse"
            @ref="@chatInput"
            />
        </div>
    </main>
</div>

@code {
    private ChatRunner chatRunner = null!;
    private ElementReference askUserInput;
    private bool focusAskUserInput;
    private ChatInput? chatInput;
    private ChatSidebar? sidebar;
    private readonly AskUserBroker askUserBroker = new();
    private List<string> pendingOptions = [];
    private string? pendingAnswer;
    private bool pendingAllowFreeText = true;

    private string? pinnedModel;
    private int streamVersion;
    private bool sidebarOpen;
    private string? pendingQuestion;

    private static readonly string[] EmptyStatePrompts =
    [
        "Tóm tắt tài liệu đã tải lên",
        "Tra cứu thông tin mới nhất",
        "Soạn email trả lời khách hàng",
        "Lập dàn ý báo cáo tuần",
    ];

    private ChatMessage? LastAssistantMessage
    {
        get
        {
            if (chatRunner.CurrentResponseMessage is not null)
                return null;

            for (var i = chatRunner.Messages.Count - 1; i >= 1; i--)
            {
                if (chatRunner.Messages[i].Role == ChatRole.Assistant && !string.IsNullOrWhiteSpace(chatRunner.Messages[i].Text))
                    return chatRunner.Messages[i];
            }
            return null;
        }
    }

    string? IChatTurnView.PinnedModel => pinnedModel;

    Task IChatTurnView.RenderAsync() => InvokeAsync(StateHasChanged);

    async Task IChatTurnView.RenderStreamAsync()
    {
        streamVersion++;
        if (chatRunner.CurrentResponseMessage is not null)
            ChatMessageItem.NotifyChanged(chatRunner.CurrentResponseMessage);
        await InvokeAsync(StateHasChanged);
    }

    Task IChatTurnView.FocusComposerAsync() => chatInput!.FocusAsync().AsTask();

    Task IChatTurnView.ReloadSidebarAsync() => sidebar!.ReloadAsync();

    void IChatTurnView.ResetAskUserPanel() => ResetPendingQuestion();

    /// <summary>The ask_user tool is awaiting this answer inside the running turn.</summary>
    private void AnswerQuestion(string answer)
    {
        askUserBroker.TryAnswer(answer);
        // Close the panel even when no question waits any more, otherwise a button left over from a
        // finished turn would keep a dead question on screen.
        ResetPendingQuestion();
    }

    private Task SubmitPendingAnswerAsync()
    {
        var answer = pendingAnswer?.Trim();
        if (!string.IsNullOrEmpty(answer)) AnswerQuestion(answer);
        return Task.CompletedTask;
    }

    private void SkipQuestion()
    {
        askUserBroker.TryDecline();
        ResetPendingQuestion();
    }

    private void ResetPendingQuestion()
    {
        pendingQuestion = null;
        pendingOptions = [];
        pendingAnswer = null;
        pendingAllowFreeText = true;
    }

    /// <summary>
    /// Mirrors the broker's waiting question into the panel; the tool call blocks in the running turn
    /// until the user answers or skips, so the agent session and iteration budget are kept.
    /// </summary>
    private void OnAskUserChanged(AskUserQuestion? question)
    {
        _ = InvokeAsync(() =>
        {
            pendingQuestion = question?.Question;
            pendingOptions = question is null ? [] : [.. question.Options];
            pendingAllowFreeText = question?.AllowFreeText ?? true;
            pendingAnswer = null;
            // Text typed into the composer is sent as a steer message, not as the answer, so a new
            // question takes the focus once its panel is rendered.
            focusAskUserInput = question is not null;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusAskUserInput) return;
        focusAskUserInput = false;
        if (!pendingAllowFreeText) return;

        try
        {
            await askUserInput.FocusAsync();
        }
        catch (Exception ex)
        {
            // The panel can already be gone when the question is cancelled while it renders.
            Logger.LogDebug(ex, "Could not focus the ask_user input.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var systemPrompt = File.ReadAllText(
            Path.Combine(Env.ContentRootPath, "prompts", "SYSTEM.md"));

        chatRunner = new ChatRunner(
            this, Logger, Store, Search, Router, Config, OpenAi, Documents, Env,
            RateLimiter, UsageTracker, Pricing, ResearchTools, CrewWriter, WebSearch, Ocr,
            askUserBroker);

        askUserBroker.Changed += OnAskUserChanged;

        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var appUser = await UserManager.FindByIdAsync(userId);
        chatRunner.Initialize(userId, AgentSettings.Load(appUser, Config), systemPrompt);
    }

    private Task AddUserMessageAsync(ChatMessage userMessage)
        => chatRunner.ProcessUserMessageAsync(userMessage, true);

    private async Task EditUserMessageAsync((ChatMessage Message, string Text) edit)
    {
        var original = edit.Message;
        var newText = edit.Text;

        if (chatRunner.ConversationId is null || string.IsNullOrWhiteSpace(chatRunner.UserId)) return;
        if (chatRunner.CurrentResponseMessage is not null) return;

        var index = chatRunner.Messages.IndexOf(original);
        if (index < 1) return;

        var trimmed = newText.Trim();
        if (trimmed.Length == 0) return;
        if (string.Equals(trimmed, original.Text, StringComparison.Ordinal)) return;

        for (var i = chatRunner.Messages.Count - 1; i > index; i--)
        {
            chatRunner.MessageAttachments.Remove(chatRunner.Messages[i]);
            chatRunner.Messages.RemoveAt(i);
        }
        await Store.DeleteMessagesFromAsync(chatRunner.ConversationId.Value, chatRunner.UserId, index + 1);

        var text = original.Contents.OfType<TextContent>().FirstOrDefault();
        if (text is null) return;
        text.Text = trimmed;
        await Store.UpdateMessageAsync(chatRunner.ConversationId.Value, chatRunner.UserId, index, trimmed);

        chatRunner.ForgetRun(chatRunner.ConversationId.Value);
        ChatMessageItem.NotifyChanged(original);
        streamVersion++;
        await InvokeAsync(StateHasChanged);

        await chatRunner.ProcessUserMessageAsync(original, false);
    }

    private async Task UploadAsync(IBrowserFile file)
    {
        if (string.IsNullOrWhiteSpace(chatRunner.UserId)) return;

        if (!chatRunner.AttachedFiles.Contains(file.Name))
        {
            chatRunner.AttachedFiles.Add(file.Name);
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            chatRunner.Status = $"Đang đọc {file.Name}…";
            await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await Documents.SaveAndIngestAsync(stream, file.Name, chatRunner.UserId);
            chatRunner.Status = null;
        }
        catch (Exception ex)
        {
            chatRunner.AttachedFiles.Remove(file.Name);
            chatRunner.Status = $"Không đọc được file đó: {ex.Message}";
        }
    }

    private void RemoveAttachedFile(string name)
    {
        chatRunner.AttachedFiles.Remove(name);
        chatRunner.Status = null;
    }

    private async Task SelectConversationAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(chatRunner.UserId) || id == chatRunner.ConversationId) return;

        chatRunner.CancelCurrentResponse();

        var rows = await Store.LoadMessagesAsync(id, chatRunner.UserId);
        var list = await Store.ListAsync(chatRunner.UserId);
        var summary = list.FirstOrDefault(c => c.Id == id);

        chatRunner.ResetTranscript();
        foreach (var row in rows)
        {
            chatRunner.Messages.Add(new ChatMessage(
                row.Role == "assistant" ? ChatRole.Assistant : ChatRole.User, row.Text));
        }

        chatRunner.ConversationId = id;
        chatRunner.Title = summary?.Title;
        chatRunner.ResetTransientState();
        ResetPendingQuestion();
        sidebarOpen = false;
        await sidebar!.ReloadAsync();
        await chatInput!.FocusAsync();
    }

    private void CancelAnyCurrentResponse() => chatRunner.CancelCurrentResponse();

    /// <summary>Re-runs the last user question after dropping the assistant replies that followed it.</summary>
    private async Task RegenerateAsync()
    {
        if (chatRunner.CurrentResponseMessage is not null) return;
        if (chatRunner.ConversationId is null || string.IsNullOrWhiteSpace(chatRunner.UserId)) return;

        var messages = chatRunner.Messages;
        var lastUserIndex = messages.FindLastIndex(
            m => m.Role == ChatRole.User && !string.IsNullOrWhiteSpace(m.Text));
        if (lastUserIndex < 1) return;

        for (var i = messages.Count - 1; i > lastUserIndex; i--)
        {
            chatRunner.MessageAttachments.Remove(messages[i]);
            chatRunner.MessageTraces.Remove(messages[i]);
            messages.RemoveAt(i);
        }
        await Store.DeleteMessagesFromAsync(chatRunner.ConversationId.Value, chatRunner.UserId, lastUserIndex + 1);

        chatRunner.ForgetRun(chatRunner.ConversationId.Value);
        streamVersion++;
        await InvokeAsync(StateHasChanged);

        await chatRunner.ProcessUserMessageAsync(messages[lastUserIndex], false);
    }

    private async Task ResetConversationAsync()
    {
        chatRunner.CancelCurrentResponse();
        chatRunner.ResetTranscript();
        chatRunner.ConversationId = null;
        pinnedModel = null;
        chatRunner.Title = null;
        chatRunner.ResetTransientState();
        ResetPendingQuestion();
        sidebarOpen = false;
        if (sidebar is not null) await sidebar.ReloadAsync();
        if (chatInput is not null) await chatInput.FocusAsync();
    }

    public void Dispose()
    {
        askUserBroker.Changed -= OnAskUserChanged;
        chatRunner?.Dispose();
    }
}
