@page "/register"
@attribute [AllowAnonymous]

<PageTitle>Tạo tài khoản</PageTitle>

<main class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-mark" aria-hidden="true">C</div>
            <h1>Tạo tài khoản</h1>
            <p class="login-sub">Đăng ký bằng email và mật khẩu.</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="login-error">@ErrorMessage</p>
        }

        <form method="post" action="/account/password-register">
            <AntiforgeryToken />
            <div class="login-fields">
                <input class="login-field" type="email" name="email"
                       placeholder="Email" required autocomplete="email" />
                <input class="login-field" type="password" name="password"
                       placeholder="Password" required autocomplete="new-password" />
                <input class="login-field" type="password" name="confirm"
                       placeholder="Confirm password" required autocomplete="new-password" />
            </div>
            <button type="submit" class="login-submit">Tạo tài khoản</button>
        </form>

        <p class="login-switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
    </div>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string ErrorMessage
    {
        get
        {
            if (Error == "mismatch")
                return "Mật khẩu xác nhận không khớp.";
            if (Error == "taken")
                return "Email này đã được đăng ký.";
            if (Error == "weak")
                return "Mật khẩu cần ít nhất 6 ký tự và gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.";
            if (Error == "invalid")
                return "Hãy nhập email và mật khẩu hợp lệ.";
            return "Không tạo được tài khoản — thử lại.";
        }
    }
}
